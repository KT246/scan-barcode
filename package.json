{
  "name": "scan-barcode",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm --filter @web-barcode/desktop dev",
    "dev:pwa": "pnpm --filter @web-barcode/scanner-pwa dev",
    "build": "pnpm build:pwa && pnpm --filter @web-barcode/desktop build",
    "build:pwa": "pnpm --filter @web-barcode/scanner-pwa build",
    "start": "pnpm --filter @web-barcode/desktop start",
    "preview": "pnpm --filter @web-barcode/desktop preview",
    "preview:pwa": "pnpm --filter @web-barcode/scanner-pwa preview"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
